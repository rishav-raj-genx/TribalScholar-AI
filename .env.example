# ==============================================================================
# TribalScholar AI: Environment Configuration (.env.example)
# Problem Statement: SIH26239
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=tribalscholar
POSTGRES_PASSWORD=tribalscholar_secret
POSTGRES_DB=tribalscholar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tribalscholar:tribalscholar_secret@localhost:5432/tribalscholar?schema=public

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_tribalscholar_min32chars_required
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage (Docker & Document Ingestion)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=tribalscholar-docs

# S3 Client Configuration (for Node.js & Python services)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=tribalscholar-docs
S3_USE_SSL=false
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.storage-local

# ------------------------------------------------------------------------------
# Core API Service (apps/api - Express + Prisma)
# ------------------------------------------------------------------------------
PORT=4000
API_PORT=4000
API_HOST=localhost
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# AI OCR & Document Intelligence Service (services/ai-ocr - FastAPI + PaddleOCR)
# ------------------------------------------------------------------------------
AI_OCR_PORT=8000
AI_OCR_HOST=0.0.0.0
AI_OCR_URL=http://localhost:8000
INTERNAL_API_KEY=tribalscholar_internal_secret_key_2026
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Web Application (apps/web - Next.js)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
